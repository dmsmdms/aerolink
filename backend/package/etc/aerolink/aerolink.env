# AeroLink backend configuration (docs/08-backend.md). Owner root:aerolink, mode 0640: holds secrets.
# Real environment variables override these values.

# Public origin of the operator console; operator WebSockets from other origins are rejected.
AEROLINK_ORIGIN=https://aerolink.example.com

# Telegram bot for error reports: token from @BotFather, chat id of the admin chat/group.
# Check with: sudo -u aerolink aerolink telegram-test
AEROLINK_TELEGRAM_TOKEN=
AEROLINK_TELEGRAM_CHAT_ID=

# WebRTC ICE servers handed to both peers of a session. TURN uses coturn's
# use-auth-secret / static-auth-secret (time-limited credentials, nothing stored).
AEROLINK_STUN_URLS=stun:aerolink.example.com:3478
AEROLINK_TURN_URLS=turn:aerolink.example.com:3478?transport=udp,turn:aerolink.example.com:3478?transport=tcp,turns:aerolink.example.com:5349?transport=tcp
AEROLINK_TURN_SECRET=

# Guard (aerolink-guard.service): addresses/networks never banned, comma-separated, e.g. your office
# and monitoring. Loopback is always allowed.
AEROLINK_GUARD_ALLOW=

# Defaults:
# AEROLINK_LISTEN=systemd            (set by aerolink.service; or unix:/path, 127.0.0.1:8080)
# AEROLINK_DATABASE=/var/lib/aerolink/aerolink.db
# AEROLINK_ERROR_LOG=/var/log/aerolink/error.log
# AEROLINK_SECURE_COOKIES=true
# AEROLINK_LOG=info                  (tracing filter, e.g. aerolink=debug)
# AEROLINK_GUARD_LISTEN=systemd      (set by aerolink-guard.service; or unix:/path)
# AEROLINK_GUARD_NFT=nft
# AEROLINK_APK_DIR=/var/lib/aerolink-apk   (robot app release: APKs + aerolink-release.json)
# AEROLINK_APK_ACCEL=/_apk/          (set by aerolink.service; empty = the backend sends APKs itself)

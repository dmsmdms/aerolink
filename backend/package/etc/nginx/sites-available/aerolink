# AeroLink — nginx site (docs/09-deployment.md).
#
# nginx does everything that is not signaling: TLS, static files (pre-compressed .br/.gz, never compressed
# on the fly), caching headers, rate limits and abuse filtering. The backend sees only /api/ and /ws/ over
# a Unix socket. Operator ↔ robot media and control are peer-to-peer (WebRTC), not proxied here.
#
# Enable:
#   1. replace aerolink.example.com below (and in /etc/aerolink/aerolink.env) with the real domain;
#   2. certificate: certbot certonly --webroot -w /var/www/letsencrypt -d <domain>
#      (first run: temporarily comment out the 443 server, or use --standalone with nginx stopped);
#   3. ln -s ../sites-available/aerolink /etc/nginx/sites-enabled/aerolink
#      rm /etc/nginx/sites-enabled/default        (this file brings its own default_server)
#   4. nginx -t && systemctl reload nginx
# Requires libnginx-mod-http-brotli-static (brotli_static).
#
# Logs:
#   /var/log/nginx/aerolink-access.log    normal traffic (buffered)
#   /var/log/nginx/aerolink-security.log  probes, scanners, foreign Host, 4xx/5xx, rate-limit hits (JSON
#                                         lines; the same lines go to `aerolink guard`, which bans repeat
#                                         offenders in nftables)
#   /var/log/nginx/aerolink-error.log     nginx errors, limit_req/limit_conn rejections

# ---------------------------------------------------------------------------------------------------
# http-level definitions (sites-enabled/* is included inside http {})
# ---------------------------------------------------------------------------------------------------

upstream aerolink_backend {
    server unix:/run/aerolink.sock;
    keepalive 16;
}

# Per-client limits, keyed by binary address (4/16 bytes: 10 MiB ≈ 80k clients).
limit_req_zone  $binary_remote_addr zone=al_static:10m rate=30r/s;
limit_req_zone  $binary_remote_addr zone=al_api:10m    rate=10r/s;
limit_req_zone  $binary_remote_addr zone=al_login:10m  rate=6r/m;
limit_req_zone  $binary_remote_addr zone=al_ws:10m     rate=20r/m;
limit_conn_zone $binary_remote_addr zone=al_conn:10m;

# Requests for things that do not exist on this site but are classic exploit / recon targets.
map $request_uri $al_probe {
    default 0;
    "~*\.(?:php\d?|phtml|asp|aspx|ashx|jsp|jspa|do|action|cgi|pl|py|sh|env|ini|conf|cfg|config|bak|backup|old|orig|save|swp|sql|sqlite|db|mdb|log|ya?ml|toml|tar|tgz|gz|zip|rar|7z|war|jar|key|pem|crt)(?:$|[?;#])" 1;
    "~/\.(?!well-known/)" 1;
    "~*(?:wp-(?:admin|login|content|includes|json)|wordpress|xmlrpc|phpmyadmin|phpunit|myadmin|adminer|cgi-bin|/vendor/|/actuator|/solr/|/jenkins|/manager/html|/boaform|/hnap1|/owa/|/autodiscover|/ecp/|/remote/login|/geoserver|/telescope|/_profiler|/server-status|/druid/|/nacos|/console/api/|/api/v1/pods|/containers/json|/\.git|/etc/passwd|/proc/self|/swagger|/api-docs|/graphql|/debug/|/setup\.|/install\.|/shell|/cmd)" 1;
    "~*(?:\.\./|%2e%2e|%252e|%00|<script|%3cscript|union[\s+]+(?:all[\s+]+)?select|/bin/(?:ba)?sh|\$\{jndi:|%24%7bjndi|base64_decode|eval\(|allow_url_include|auto_prepend_file)" 1;
}

# Vulnerability scanners and abusive crawlers. Empty User-Agent is never a real browser or the robot app.
map $http_user_agent $al_bad_agent {
    default 0;
    "" 1;
    "~*(?:sqlmap|nikto|nmap|masscan|zgrab|zmap|nuclei|acunetix|nessus|openvas|qualys|netsparker|wpscan|joomscan|dirbuster|dirb/|gobuster|ffuf|feroxbuster|wfuzz|whatweb|jaeles|xray|httpx|fuzz|scan|exploit|l9explore|l9tcpid|censys|shodan|internetmeasurement|expanse|paloalto|odin\.io|leakix|ahrefs|semrush|mj12bot|dotbot|petalbot|bytespider|dataforseo|serpstat|blexbot|megaindex|zoominfo)" 1;
}

map $request_method $al_bad_method {
    default 1;
    GET     0;
    HEAD    0;
    POST    0;
    PUT     0;
    PATCH   0;
    DELETE  0;
}

# Why a request is refused (empty = it is not). Checked once per request in the servers below.
map "$al_probe$al_bad_agent$al_bad_method" $al_reason {
    default "";
    "~^1"   probe;
    "~^01"  agent;
    "~^001" method;
}

# What goes to the security log: refused requests plus auth failures, missing files, limits, errors.
map "$al_reason:$status" $al_security {
    default 0;
    "~^[a-z]" 1;
    "~:(?:400|401|403|404|405|408|413|414|429|444|494|495|496|497|500|502|503|504)$" 1;
}

log_format al_main '$remote_addr [$time_iso8601] "$request" $status $body_bytes_sent $request_time '
                   '"$http_referer" "$http_user_agent" $upstream_response_time';

log_format al_security escape=json
    '{"t":"$time_iso8601","ip":"$remote_addr","reason":"$al_reason","status":$status,'
    '"method":"$request_method","host":"$host","uri":"$request_uri","ua":"$http_user_agent",'
    '"ref":"$http_referer","bytes":$body_bytes_sent,"rt":$request_time}';

# For `aerolink guard` (syslog): only what it needs, bounded. nginx silently drops syslog messages over ~2 KiB,
# so a full URI or User-Agent would let a client dodge bans with a long request.
map $request_uri $al_uri_head {
    default "";
    "~^(.{0,160})" $1;
}

log_format al_guard escape=json
    '{"ip":"$remote_addr","reason":"$al_reason","status":$status,"uri":"$al_uri_head"}';

log_format al_guard_nohost escape=json
    '{"ip":"$remote_addr","reason":"nohost","status":$status,"uri":"$al_uri_head"}';

log_format al_nohost escape=json
    '{"t":"$time_iso8601","ip":"$remote_addr","reason":"nohost","status":$status,'
    '"method":"$request_method","host":"$host","uri":"$request_uri","ua":"$http_user_agent"}';

# ---------------------------------------------------------------------------------------------------
# Catch-all: requests by bare IP or for foreign host names are scanners. Plain HTTP gets its connection
# dropped (444, logged); TLS without our SNI is refused during the handshake (no certificate leaks).
# ---------------------------------------------------------------------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_reject_handshake on;
    access_log /var/log/nginx/aerolink-security.log al_nohost;
    access_log syslog:server=unix:/run/aerolink-guard.sock,nohostname,tag=aerolink al_guard_nohost;
    return 444;
}

# ---------------------------------------------------------------------------------------------------
# Plain HTTP: ACME challenges, everything else → HTTPS.
# ---------------------------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name aerolink.example.com;

    include snippets/aerolink-security-log.conf;

    if ($al_reason) {
        return 444;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------------------------------
# The site.
# ---------------------------------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name aerolink.example.com;

    # --- TLS ---
    ssl_certificate     /etc/letsencrypt/live/aerolink.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aerolink.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ecdh_curve X25519MLKEM768:X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:al_tls:10m;   # ~40k sessions
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_buffer_size 4k;                    # small records: faster first byte

    # --- connections and request size ---
    keepalive_timeout 30s;
    keepalive_requests 1000;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 15s;
    reset_timedout_connection on;
    client_max_body_size 16k;              # the API takes small JSON only (backend limit is the same)
    client_body_buffer_size 16k;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 8k;
    limit_conn al_conn 40;
    limit_conn_status 429;
    limit_req_status 429;
    limit_req_log_level warn;

    # --- static files: pre-compressed at build time, nginx only picks the variant ---
    root /usr/share/aerolink/www;
    charset utf-8;
    gzip off;
    gzip_static on;
    brotli_static on;
    gzip_vary on;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    open_file_cache max=2000 inactive=5m;
    open_file_cache_valid 2m;
    open_file_cache_min_uses 1;
    open_file_cache_errors on;
    etag on;

    # --- logs ---
    access_log /var/log/nginx/aerolink-access.log al_main buffer=64k flush=1m;
    include snippets/aerolink-security-log.conf;
    error_log  /var/log/nginx/aerolink-error.log warn;

    # --- filtering (see the maps above) ---
    if ($al_reason) {
        return 444;
    }

    # Security headers. add_header in a location replaces the inherited set, hence the snippet is
    # included in every location that adds its own headers.
    include snippets/aerolink-headers.conf;

    # Content-hashed build output (Vite): cache forever, never log hits.
    location /assets/ {
        limit_req zone=al_static burst=200 nodelay;
        include snippets/aerolink-security-log.conf;
        include snippets/aerolink-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Operator console (single-page app).
    location /console/ {
        limit_req zone=al_static burst=100 nodelay;
        include snippets/aerolink-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /console/index.html;
    }

    location = /robots.txt {
        access_log off;
        try_files $uri =404;
    }

    location = /favicon.svg {
        access_log off;
        include snippets/aerolink-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    # Public pages (landing now; registration, rental, … later).
    location / {
        limit_req zone=al_static burst=100 nodelay;
        include snippets/aerolink-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ $uri.html =404;
    }

    # --- backend ---
    location = /api/v1/login {
        limit_req zone=al_login burst=5 nodelay;
        limit_except POST { deny all; }
        include snippets/aerolink-proxy.conf;
    }

    location = /api/v1/health {
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        include snippets/aerolink-proxy.conf;
    }

    location /api/ {
        limit_req zone=al_api burst=40 nodelay;
        include snippets/aerolink-proxy.conf;
    }

    # Robot app updates (ROB-008): the backend checks the robot token on /api/v1/robot/apk/<abi> and hands
    # the file over with X-Accel-Redirect; never reachable directly.
    location /_apk/ {
        internal;
        alias /var/lib/aerolink-apk/;
        types { application/vnd.android.package-archive apk; }
        include snippets/aerolink-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # Signaling WebSockets: operators (cookie) and robots (bearer token). Long-lived and almost silent:
    # robots ping every 2–4 min to spare the cellular radio (PWR-012), hence the long read timeout.
    location /ws/ {
        limit_req zone=al_ws burst=10 nodelay;
        limit_except GET { deny all; }
        proxy_pass http://aerolink_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
    }
}

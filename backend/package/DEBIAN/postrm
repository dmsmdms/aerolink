#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
    # Data and logs go only on purge; the database holds operators and robot tokens.
    rm -rf /var/lib/aerolink /var/lib/aerolink-apk /var/log/aerolink
    if getent passwd aerolink >/dev/null; then
        deluser --system aerolink >/dev/null || true
    fi
    if getent group aerolink >/dev/null; then
        delgroup --system aerolink >/dev/null || true
    fi
    rm -f /etc/nginx/sites-enabled/aerolink
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Lift all bans with the guard gone.
    if command -v nft >/dev/null; then
        nft delete table inet aerolink_guard 2>/dev/null || true
    fi
fi

systemctl daemon-reload >/dev/null 2>&1 || true

exit 0
